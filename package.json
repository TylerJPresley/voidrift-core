{
  "name": "@voidrift/core",
  "version": "0.1.1",
  "description": "VoidRift core SDK — the headless, model- and environment-agnostic agentic engine.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "seed",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "manifest:update": "node scripts/update-shipped-hashes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "coverage": "vitest --run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.12",
    "@langchain/core": "1.2.17",
    "@langchain/google-genai": "2.3.2",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint": "1.1.6",
    "@langchain/langgraph-checkpoint-postgres": "1.0.6",
    "@langchain/langgraph-sdk": "1.12.3",
    "@langchain/openai": "1.6.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/keyring": "2.1.0",
    "chokidar": "5.0.0",
    "deepagents": "1.14.2",
    "langchain": "1.5.16",
    "langsmith": "0.9.0",
    "linkedom": "0.18.13",
    "liqe": "3.8.7",
    "mdast-util-heading-range": "4.0.0",
    "mdast-util-toc": "7.1.0",
    "remark-parse": "11.0.0",
    "undici": "8.12.3",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "voidrift": {
    "kind": "library"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift-core.git"
  },
  "bugs": {
    "url": "https://github.com/TylerJPresley/voidrift-core/issues"
  },
  "homepage": "https://github.com/TylerJPresley/voidrift-core#readme",
  "keywords": [
    "voidrift",
    "core",
    "sdk",
    "headless",
    "model"
  ],
  "publishConfig": {
    "access": "public"
  }
}
